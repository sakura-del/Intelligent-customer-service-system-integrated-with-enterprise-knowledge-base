# ===== 应用基础配置 =====
APP_NAME=Intelligent Customer Service System
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# ===== 鉴权配置 =====
# 服务端 API Key，客户端需在请求头 X-API-Key 中携带；为空时进入开发免鉴权模式
API_KEY=

# ===== LLM 配置（后续接入 RAG 使用）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== Embedding 模型配置 =====
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# ===== ChromaDB 向量库配置 =====
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=knowledge_base

# ===== 文本切分配置 =====
CHUNK_SIZE=512
CHUNK_OVERLAP=128

# ===== 检索与去重阈值 =====
SIMILARITY_THRESHOLD=0.6
DEDUP_THRESHOLD=0.95

# ===== Embedding 批大小（内存控制）=====
EMBEDDING_BATCH_SIZE=32

# ===== Redis（会话存储、缓存）=====
REDIS_URL=redis://localhost:6379/0

# ===== Elasticsearch（全文检索）=====
ELASTICSEARCH_URL=http://localhost:9200

# ===== 混合检索（向量 + BM25 + RRF）配置 =====
# 单路召回数量：向量与关键词各召回 top-N 后融合
VECTOR_TOP_K=25
BM25_TOP_K=25
# RRF 融合参数：k 平滑排名，权重用于加权融合（向量 60% / 关键词 40%）
RRF_K=60
RRF_VECTOR_WEIGHT=0.6
RRF_KEYWORD_WEIGHT=0.4
# Reranker：取 top-K 进入最终答案
RERANK_TOP_K=5
# CrossEncoder 重排序模型，默认 BGE 中文 reranker
RERANKER_MODEL=BAAI/bge-reranker-base

# ===== 人工客服转接配置 =====
# 人工服务时间段（24 小时制，[START, END)），超出该区间不主动转接情绪/失败类诉求
# 但用户主动要求"转人工"时仍会转接
WORKING_HOURS_START=9
WORKING_HOURS_END=18
# 时区，默认上海时区
TIMEZONE=Asia/Shanghai

# ===== 业务系统适配器配置（Task 15）=====
# 适配器模式：mock=内存 mock；http=真实业务系统 REST API
# 默认 mock 保证开箱即用，切换真实测试环境时改为 http
BUSINESS_ADAPTER_MODE=mock
# 真实业务系统 API 基址，http 模式必填；留空将自动降级 mock 并告警
BUSINESS_API_BASE_URL=
# 真实业务系统 API Key，写入 X-API-Key 请求头
BUSINESS_API_KEY=
# HTTP 调用超时秒数
BUSINESS_API_TIMEOUT=10
